# --- База данных ---
DATABASE_URL=postgresql://gdetech:gdetech@db:5432/gdetech

# --- Сессии ---
SESSION_COOKIE_NAME=gdetech_auth

# --- E-mail код входа ---
AUTH_CODE_TTL_MINUTES=10
AUTH_MAX_CODE_ATTEMPTS=5

# Пока SMTP_ENABLED=false — код входа возвращается в ответе API и пишется в лог сервера.
# Это осознанное упрощение для локального MVP-превью без настроенной почты.
SMTP_ENABLED=false
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@gdetech.ru
SMTP_FROM_NAME=GdeTech

# --- Yandex ID (заведите приложение на https://oauth.yandex.ru) ---
YANDEX_AUTH_ENABLED=false
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:3001/api/auth/yandex/callback
YANDEX_SUCCESS_URL=/
YANDEX_ERROR_URL=/?auth_error=yandex
NEXT_PUBLIC_YANDEX_AUTH_ENABLED=false

# --- VK ID (заведите приложение на https://id.vk.com) ---
VK_AUTH_ENABLED=false
VK_CLIENT_ID=
VK_REDIRECT_URI=http://localhost:3001/api/auth/vk/callback
VK_SUCCESS_URL=/
VK_ERROR_URL=/?auth_error=vk
NEXT_PUBLIC_VK_AUTH_ENABLED=false

# --- Админ-аккаунт (сидируется при первом запуске) ---
ADMIN_EMAIL=andrey.shelemetev@gmail.com

# --- Прочее ---
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NODE_ENV=production
